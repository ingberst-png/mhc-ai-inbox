# MHC AI Inbox - environment variables
# Copy to .env for local dev; set the same keys in Railway for the cloud deploy.

# --- Required: Notion ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Required: Anthropic ---
ANTHROPIC_API_KEY=

# --- Required: Gmail OAuth ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=        # generated locally via forwarder/get_refresh_token.py
                            # must cover BOTH gmail.readonly AND calendar.events.owned scopes
                            # (re-mint if you upgraded from a gmail-only token)

# --- Required: Resend (morning digest) ---
RESEND_API_KEY=
DIGEST_RECIPIENT=steve@milehighcook.net

# --- Required: Mac forwarder <-> cloud webhook auth ---
FORWARDER_SECRET=

# --- Required by the Mac forwarder only (not read by the cloud agent) ---
WEBHOOK_URL=                # e.g., https://mhc-ai-inbox.up.railway.app/webhook/imessage

# --- Auto-provided by Railway ---
# DATABASE_URL              # Postgres connection string, injected by the Postgres plugin

# --- Optional, with defaults ---
# PROMPT_VERSION=v1
# LOG_LEVEL=INFO
# DIGEST_FROM=onboarding@resend.dev
#   Resend sandbox sender for v1 (deliverable to verified Resend account emails only).
#   Flip to "MHC AI Inbox <ai-inbox@milehighcook.net>" once the milehighcook.net domain
#   is verified in Resend via DNS records in Squarespace.
